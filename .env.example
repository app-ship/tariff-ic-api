# ── Server ───────────────────────────────────────────────────────────────────
PORT=3002

# ── Upstream ──────────────────────────────────────────────────────────────────
# URL of the deep-research FastAPI service (no trailing slash)
DEEP_RESEARCH_URL=http://127.0.0.1:8979

# ── Auth0 JWT verification ────────────────────────────────────────────────────
# The issuer URL of your NEW dedicated Auth0 tenant (no trailing slash OK)
# e.g. https://tariffic-prod.us.auth0.com
AUTH0_ISSUER_BASE_URL=

# The API identifier (audience) registered in Auth0 for this API
# e.g. https://api.tariffic.ai
AUTH0_AUDIENCE=

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Full connection string including credentials
# e.g. mongodb+srv://user:pass@cluster.mongodb.net/tariff-ic
MONGODB_URI=

# Database name (defaults to "tariff-ic")
MONGODB_DB_NAME=tariff-ic

# ── Dev defaults ──────────────────────────────────────────────────────────────
# Used in dev bypass mode (when AUTH0_ISSUER_BASE_URL is not set)
DEFAULT_ORG_ID=tariffic-dev-org
DEFAULT_USER_ID=tariffic-dev-user

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (your frontend URL)
CORS_ORIGINS=http://localhost:5174
