# ── Server ──────────────────────────────────────────────────────────────
PORT=3002

# ── Upstream ─────────────────────────────────────────────────────────────
# URL of the deep-research FastAPI service (no trailing slash)
DEEP_RESEARCH_URL=http://127.0.0.1:8979

# ── Auth ─────────────────────────────────────────────────────────────────
# API key that UI clients must send in the X-Api-Key header
# (set a long random string in production; see README)
API_KEY=change-me-in-production

# JWT secret for signed user tokens (optional — used if JWT auth is enabled)
# JWT_SECRET=your-jwt-secret

# ── Tenancy defaults ─────────────────────────────────────────────────────
# Fallback org / user stamped on requests when no auth token is present
# (only used in BYPASS_AUTH / dev mode)
DEFAULT_ORG_ID=tariffic-dev-org
DEFAULT_USER_ID=tariffic-dev-user

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (e.g. your frontend URL)
CORS_ORIGINS=http://localhost:5174
