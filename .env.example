# ── Server ───────────────────────────────────────────────────────────────────
PORT=3002

# ── Upstream ──────────────────────────────────────────────────────────────────
# URL of the deep-research FastAPI service (no trailing slash)
DEEP_RESEARCH_URL=http://127.0.0.1:8979

# ── Auth0 (custom consumer login via ROPG) ────────────────────────────────────
# Dedicated Auth0 tenant — issuer URL (no trailing slash)
AUTH0_ISSUER_BASE_URL=https://YOUR_TENANT.us.auth0.com
AUTH0_DOMAIN=YOUR_TENANT.us.auth0.com

# API identifier registered in Auth0 (audience)
AUTH0_AUDIENCE=https://api.tariffic.ai

# M2M backend client with password + client_credentials grants enabled
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Auth0 database connection name for username/password signup
AUTH0_DB_CONNECTION=Username-Password-Authentication

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Full connection string including credentials
MONGODB_URI=

# Database name (defaults to "tariff-ic")
MONGODB_DB_NAME=tariff-ic

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (your frontend URL)
CORS_ORIGINS=http://localhost:5174

# ── Monitor cron ──────────────────────────────────────────────────────────────
# Shared secret required in the X-CRON-SECRET header on POST /monitor/cron/run.
# Cloud Scheduler must send this header. Leave blank in dev to allow unguarded calls.
CRON_SECRET=
